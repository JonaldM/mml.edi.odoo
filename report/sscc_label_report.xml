<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- A6 (105mm x 148mm) paper format — the label is fixed-size real
             estate per Animates_SSCC_Label_Specification.pdf p.4: "The label
             MUST NOT be re formatted." No header/footer margin, no company
             letterhead — this is a shipping label, not a business document. -->
        <record id="paperformat_sscc_label_a6" model="report.paperformat">
            <field name="name">SSCC Label A6</field>
            <field name="format">custom</field>
            <field name="page_height">148</field>
            <field name="page_width">105</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_sscc_label" model="ir.actions.report">
            <field name="name">Animates SSCC Label</field>
            <field name="model">sscc.register</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mml_edi.report_sscc_label</field>
            <field name="report_file">mml_edi.report_sscc_label</field>
            <field name="print_report_name">'SSCC_Label_%s' % (object.sscc)</field>
            <field name="paperformat_id" ref="paperformat_sscc_label_a6"/>
            <field name="binding_model_id" ref="model_sscc_register"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Bare template — NO web.external_layout (that adds Odoo's company
             letterhead/header/footer). A shipping label must not carry a
             second company banner — Zone A already carries Ship From per
             the spec, and the "real estate" fixed-layout requirement (p.4)
             forbids extra content. web.basic_layout (used below, in
             report_sscc_label) only supplies the bare HTML/CSS shell QWeb-PDF
             needs — no letterhead. -->
        <template id="report_sscc_label_document">
            <t t-foreach="docs" t-as="o">
                <t t-set="data" t-value="o.get_label_data()"/>
                <!-- overflow:hidden + a height slightly under the A6 page keeps
                     every zone (crucially Zone G, the SSCC barcode) on the SAME
                     physical label. Without it the barcode was pushed onto a
                     following page, so each printed label lost its barcode and
                     the run produced N+1 pages for N labels. -->
                <div class="sscc-label-page"
                     style="width:105mm;height:146mm;max-height:146mm;overflow:hidden;
                            box-sizing:border-box;border:0.3mm solid #000;
                            font-family:Arial,Helvetica,sans-serif;font-size:9pt;page-break-after:always;
                            display:flex;flex-direction:column;">

                    <!-- Zone A / B: Ship From | Ship To.
                         Every zone carries an EXPLICIT height that sums under
                         the A6 page: 34 + 26 + 34 + 44 = 138mm. Address text is
                         unbounded (an Odoo partner address can wrap to many
                         lines), so without fixed zone heights a long address
                         pushes Zone G — the SSCC barcode — off the label
                         entirely. Each zone clips its own overflow instead. -->
                    <div style="display:flex;height:34mm;overflow:hidden;border-bottom:0.3mm solid #000;">
                        <div style="width:50%;padding:2mm;border-right:0.3mm solid #000;">
                            <div style="font-weight:bold;">Ship From:</div>
                            <div t-esc="data['ship_from_name']"/>
                            <div t-esc="data['ship_from_address']"/>
                        </div>
                        <div style="width:50%;padding:2mm;">
                            <div style="font-weight:bold;">
                                Ship To: <span t-esc="data['ship_to_code']"/>
                            </div>
                            <div t-esc="data['ship_to_name']"/>
                            <div t-esc="data['ship_to_address']"/>
                        </div>
                    </div>

                    <!-- Zone C / D: postal-code barcode | carrier/connote/count -->
                    <div style="display:flex;height:26mm;overflow:hidden;border-bottom:0.3mm solid #000;">
                        <div style="width:50%;padding:2mm;border-right:0.3mm solid #000;">
                            <div t-esc="data['ship_to_postal_code']"/>
                            <t t-if="data['ship_to_postal_code']">
                                <img style="width:100%;max-height:12mm;"
                                     t-att-src="data['postcode_barcode_src']"/>
                            </t>
                        </div>
                        <div style="width:50%;padding:2mm;">
                            <div><strong>Carrier:</strong> <span t-esc="data['carrier_name']"/></div>
                            <div><strong>Connote #:</strong> <span t-esc="data['connote']"/></div>
                            <div>
                                <strong>
                                    <t t-if="data['unit_type'] == 'pallet'">Number of Pallets:</t>
                                    <t t-else="">Number of Cartons:</t>
                                </strong>
                                <span t-esc="data['unit_sequence']"/>
                            </div>
                        </div>
                    </div>

                    <!-- Zone E / F: SSCC/PO#/ISC/qty | vendor part/description -->
                    <div style="display:flex;height:34mm;overflow:hidden;border-bottom:0.3mm solid #000;">
                        <div style="width:50%;padding:2mm;border-right:0.3mm solid #000;">
                            <div><strong>SSCC:</strong></div>
                            <div t-esc="data['sscc']"/>
                            <div><strong>PO #:</strong> <span t-esc="data['po_number']"/></div>
                            <div><strong>ISC:</strong> <span t-esc="data['isc']"/></div>
                            <div><strong>Carton Qty:</strong> <span t-esc="data['carton_qty']"/></div>
                        </div>
                        <div style="width:50%;padding:2mm;">
                            <div><strong>Vendor Part #:</strong> <span t-esc="data['vendor_part_no']"/></div>
                            <div><strong>Description:</strong> <span t-esc="data['description']"/></div>
                        </div>
                    </div>

                    <!-- Zone G: SSCC GS1-128 barcode (AI 00), human-readable.
                         Fixed height (not flex:1) so the barcode cannot be
                         reflowed off the label by long text above it. Barcode
                         is 78mm x 32mm per the Animates spec. -->
                    <div style="height:44mm;min-height:44mm;padding:3mm;text-align:center;
                                page-break-inside:avoid;">
                        <img style="width:78mm;height:32mm;"
                             t-att-src="data['sscc_barcode_src']"/>
                        <div t-esc="'(00) %s' % data['sscc']" style="margin-top:1mm;"/>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_sscc_label">
            <t t-call="web.basic_layout">
                <t t-call="mml_edi.report_sscc_label_document"/>
            </t>
        </template>

    </data>
</odoo>
