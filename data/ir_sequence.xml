<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Order-review reference: year-segmented with a yearly-reset
             subsequence (use_date_range) -> EDI/26/00001, EDI/26/00002, ...
             counter resets each Jan 1. Internal review reference only;
             idempotency keys on customer_po_number, not on this name, and no
             code parses the EDI/ format (verified 2026-06-22). -->
        <record id="seq_edi_order_review" model="ir.sequence">
            <field name="name">EDI Order Review</field>
            <field name="code">edi.order.review</field>
            <field name="prefix">EDI/%(range_y)s/</field>
            <field name="suffix"></field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <record id="seq_edi_log" model="ir.sequence">
            <field name="name">EDI Log</field>
            <field name="code">edi.log</field>
            <field name="prefix">EDILOG/</field>
            <field name="suffix"></field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_edi_asn_ctrl_ref" model="ir.sequence">
            <field name="name">EDI ASN Control Reference</field>
            <field name="code">edi.asn.ctrl.ref</field>
            <field name="prefix"></field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
