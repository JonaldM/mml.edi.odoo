<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Briscoes Group trading partner configuration must be created manually
        post-install via the EDI > Trading Partners form view.

        Required fields to set:
          - partner_id: Briscoes Group res.partner record (ID varies per database)
          - ftp_user / ftp_password: EDIS VAN credentials (never commit to source control)
          - alert_email_ids: email recipients for review alerts

        PRODUCTION values (Briscoes sends SAP iDOC XML over the EDIS VAN):
          name: Briscoes Group
          code: BRISCOES
          edi_format: idoc_xml
          parser_class: mml_edi.parsers.briscoes_idoc.BriscoesIDOCParser
          product_match_field: default_code   # match on the MML code (iDOC E1EDP19
                                              # QUALF 002); the QUALF 003 GTIN is the
                                              # CARTON/shipper barcode, not Odoo's retail
                                              # product.barcode, so do NOT match on barcode
          ftp_host: post.edis.co.nz
          ftp_port: 21
          ftp_protocol: ftp
          ftp_inbox_path: /FromEDIS
          ftp_outbox_path: /ToEDIS
          ftp_test_inbox_path: /Test/FromEDIS
          ftp_test_outbox_path: /Test/ToEDIS
          environment: test            # start in 'test' (uses the /Test paths) and
                                       # only switch to 'production' after a /Test
                                       # ORDRSP is accepted by EDIS
          poll_interval_minutes: 15
          order_split_mode: per_store
          client_ref_template: {po_number}_{store_code}
          auto_confirm_clean: True
          alert_on_issues: True
          pricelist_id: an EX-GST (GST-exclusive) Briscoes pricelist — a GST-inclusive
                        pricelist is rejected by an @api.constrains (EDI prices are net)

        EDIFACT D96A is also supported (parsers/briscoes.briscoesParser) if Briscoes
        ever switches MML from iDOC to EDIFACT — change edi_format/parser_class only.

        Prereqs in the target DB before first poll: the Briscoes res.partner exists,
        each store is a child contact with ref = the store/WERKS code, and the ex-GST
        pricelist is assigned. See docs/PROD_CUTOVER.md.
    -->
</odoo>
