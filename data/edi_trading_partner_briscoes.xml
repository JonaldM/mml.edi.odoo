<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Briscoes Group trading partner configuration must be created manually
        post-install via the EDI > Trading Partners form view.

        Required fields to set:
          - partner_id: Briscoes Group res.partner record (ID varies per database)
          - ftp_user / ftp_password: EDIS VAN credentials (never commit to source control)
          - alert_email_ids: email recipients for review alerts

        Suggested values:
          name: Briscoes Group
          code: BRISCOES
          edi_format: edifact_d96a
          parser_class: mml_edi.parsers.briscoes.BriscoesParser
          ftp_host: post.edis.co.nz
          ftp_port: 21
          ftp_protocol: ftp
          ftp_inbox_path: /FromEDIS
          ftp_outbox_path: /ToEDIS
          ftp_test_inbox_path: /Test/FromEDIS
          ftp_test_outbox_path: /Test/ToEDIS
          environment: production
          poll_interval_minutes: 15
          order_split_mode: per_store
          client_ref_template: {po_number}_{store_code}
          auto_confirm_clean: True
          alert_on_issues: True
    -->
</odoo>
