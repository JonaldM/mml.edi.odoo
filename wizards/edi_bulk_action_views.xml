<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for the bulk approve wizard -->
    <record id="view_edi_bulk_action_form" model="ir.ui.view">
        <field name="name">edi.bulk.action.form</field>
        <field name="model">edi.bulk.action</field>
        <field name="arch" type="xml">
            <form string="Bulk Approve EDI Reviews">
                <sheet>
                    <!-- Summary section -->
                    <group string="Summary">
                        <div class="o_wrap_field o_field_widget" colspan="2">
                            <span>
                                <field name="pending_count" readonly="1"/> records pending review selected.
                            </span>
                        </div>
                        <group>
                            <field name="new_order_count" readonly="1" string="New Orders"/>
                            <field name="change_order_count" readonly="1" string="Change Orders"/>
                        </group>
                        <group>
                            <field
                                name="blocking_count"
                                readonly="1"
                                string="Blocking Issues (cannot auto-approve)"
                                decoration-danger="blocking_count > 0"
                            />
                            <field
                                name="approvable_count"
                                readonly="1"
                                string="Will Be Approved"
                                decoration-success="approvable_count > 0"
                            />
                        </group>
                    </group>

                    <!-- Warning when some records have blocking issues -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="blocking_count == 0"
                    >
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        <field name="blocking_count" readonly="1"/> record(s) with blocking issues will be skipped and require manual review.
                    </div>

                    <!-- Review list -->
                    <field
                        name="review_ids"
                        readonly="1"
                        string="Selected Reviews"
                        optional="hide"
                    >
                        <list>
                            <field name="customer_po_number" string="PO Number"/>
                            <field
                                name="document_type"
                                string="Type"
                                widget="badge"
                                decoration-info="document_type == 'new_order'"
                                decoration-warning="document_type == 'change_order'"
                            />
                            <field
                                name="blocking_issue_count"
                                string="Blocking Issues"
                                decoration-danger="blocking_issue_count > 0"
                            />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_approve_all"
                        type="object"
                        string="Approve Selected"
                        class="btn-primary"
                        invisible="approvable_count == 0"/>

                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard from the list view action menu -->
    <record id="action_edi_bulk_approve_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Approve</field>
        <field name="res_model">edi.bulk.action</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_edi_order_review"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
