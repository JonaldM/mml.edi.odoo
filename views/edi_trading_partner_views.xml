<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LIST VIEW                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_trading_partner_list" model="ir.ui.view">
            <field name="name">edi.trading.partner.list</field>
            <field name="model">edi.trading.partner</field>
            <field name="arch" type="xml">
                <list string="EDI Trading Partners">
                    <field name="name" string="Partner Name"/>
                    <field name="code" string="Code"/>
                    <field name="edi_format"
                           widget="badge"
                           string="Format"/>
                    <field name="environment"
                           widget="badge"
                           string="Environment"
                           decoration-warning="environment == 'test'"/>
                    <field name="health_state" string="Health" widget="badge"
                           decoration-success="health_state == 'ok'"
                           decoration-info="health_state == 'review'"
                           decoration-danger="health_state in ('circuit_open', 'error')"
                           decoration-muted="health_state == 'never'"/>
                    <field name="pending_review_count" string="To Review" optional="show"/>
                    <field name="last_poll_date" string="Last Activity" optional="show"/>
                    <field name="auto_confirm_clean"
                           string="Auto-Confirm Clean"
                           widget="boolean_toggle"/>
                    <field name="active"
                           widget="boolean_toggle"
                           optional="show"/>
                </list>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- KANBAN VIEW — connection health at a glance                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_trading_partner_kanban" model="ir.ui.view">
            <field name="name">edi.trading.partner.kanban</field>
            <field name="model">edi.trading.partner</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="environment"/>
                    <field name="active"/>
                    <field name="health_state"/>
                    <field name="last_poll_date"/>
                    <field name="pending_review_count"/>
                    <field name="error_recent_count"/>
                    <field name="setup_complete"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click p-2">

                                <!-- Title row: name + health dot -->
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="fs-6 text-truncate me-2">
                                        <field name="name"/>
                                    </strong>
                                    <span t-attf-class="badge rounded-pill #{
                                        record.health_state.raw_value === 'ok' ? 'text-bg-success' :
                                        record.health_state.raw_value === 'review' ? 'text-bg-info' :
                                        record.health_state.raw_value === 'never' ? 'text-bg-secondary' :
                                        'text-bg-danger'}">
                                        <t t-esc="record.health_state.value"/>
                                    </span>
                                </div>

                                <!-- Code + environment -->
                                <div class="text-muted small mb-2">
                                    <span><t t-esc="record.code.value"/></span>
                                    <span t-if="record.environment.raw_value === 'test'"
                                          class="badge text-bg-warning ms-1">TEST</span>
                                    <span t-if="!record.active.raw_value"
                                          class="badge text-bg-secondary ms-1">Archived</span>
                                </div>

                                <!-- Signals row -->
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span t-if="record.pending_review_count.raw_value > 0"
                                          class="badge text-bg-info">
                                        <t t-esc="record.pending_review_count.value"/> to review
                                    </span>
                                    <span t-if="record.error_recent_count.raw_value > 0"
                                          class="badge text-bg-danger">
                                        <t t-esc="record.error_recent_count.value"/> errors / 24h
                                    </span>
                                    <span t-if="!record.setup_complete.raw_value"
                                          class="badge text-bg-warning">Setup incomplete</span>
                                </div>

                                <!-- Last poll -->
                                <div class="small text-muted">
                                    <i class="fa fa-clock-o me-1" role="img" aria-label="Last poll"/>
                                    <t t-if="record.last_poll_date.raw_value">
                                        Last activity: <field name="last_poll_date" widget="relative"/>
                                    </t>
                                    <t t-else="">Never polled</t>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FORM VIEW                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_trading_partner_form" model="ir.ui.view">
            <field name="name">edi.trading.partner.form</field>
            <field name="model">edi.trading.partner</field>
            <field name="arch" type="xml">
                <form string="EDI Trading Partner">

                    <!-- Header: Test / Poll / Seed + environment statusbar
                         (the design's Test/Production segmented toggle maps to
                         Odoo's native clickable statusbar). Dirty Save/Discard is
                         provided by the form itself. -->
                    <header>
                        <button name="action_test_ftp_connection"
                                string="Test connection"
                                type="object"
                                class="btn-secondary"
                                icon="fa-plug"/>
                        <button name="action_run_poll_now"
                                string="Run poll now"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                        <button name="%(mml_edi.action_edi_seed_stores_wizard)d"
                                string="Seed Store Partners"
                                type="action"
                                invisible="order_split_mode != 'per_store'"
                                groups="mml_edi.group_edi_manager"
                                help="Create missing store contacts as child delivery addresses. Safe to run multiple times — skips existing records."/>
                        <field name="environment"
                               widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>

                    <sheet>

                        <!-- Smart buttons -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_pending_reviews"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-inbox">
                                <field name="pending_review_count" widget="statinfo"
                                       string="To Review"/>
                            </button>
                            <button name="action_run_poll_now"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-refresh"
                                    groups="mml_edi.group_edi_manager">
                                <div class="o_stat_info">
                                    <field name="health_state" class="o_stat_text"/>
                                    <span class="o_stat_text">Health</span>
                                </div>
                            </button>
                        </div>

                        <!-- Test environment alert banner -->
                        <div class="alert alert-warning mb-3"
                             invisible="environment != 'test'"
                             role="alert">
                            <strong>TEST ENVIRONMENT</strong> — This partner is configured
                            to use test FTP paths and the Odoo test database.
                            No production data will be affected.
                        </div>

                        <!-- Guided setup checklist — shown until fully configured -->
                        <div class="alert alert-info mb-3"
                             invisible="setup_complete"
                             role="alert">
                            <strong><i class="fa fa-list-check me-1" role="img" aria-label="Checklist"/> Setup checklist</strong>
                            <div class="mt-2">
                                <div>
                                    <field name="setup_credentials_ok" widget="boolean" readonly="1" class="me-1"/>
                                    1. Enter FTP/SFTP credentials (Host, Username, Password) on the
                                    <strong>FTP Configuration</strong> tab
                                </div>
                                <div>
                                    <field name="setup_pricelist_ok" widget="boolean" readonly="1" class="me-1"/>
                                    2. Set the <strong>Price List</strong> used for EDI price comparison
                                </div>
                                <div invisible="order_split_mode != 'per_store'">
                                    <field name="setup_stores_ok" widget="boolean" readonly="1" class="me-1"/>
                                    3. Seed store contacts — use <strong>Seed Store Partners</strong> in the header
                                </div>
                                <div>
                                    <field name="setup_tested_ok" widget="boolean" readonly="1" class="me-1"/>
                                    4. Verify the connection — click <strong>Test FTP Connection</strong>, then <strong>Poll Now</strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-2">
                                When all items are green, switch <strong>Environment</strong> to Production
                                and enable the <em>EDI: Poll Trading Partners</em> scheduled action
                                (see docs/PROD_CUTOVER.md for the go-live sequence).
                            </div>
                        </div>

                        <!-- Ready banner -->
                        <div class="alert alert-success mb-3"
                             invisible="not setup_complete"
                             role="alert">
                            <strong><i class="fa fa-check-circle me-1" role="img" aria-label="Ready"/> Setup complete</strong>
                            — credentials, pricelist, and a successful connection test are in place.
                        </div>

                        <!-- Title row with active toggle -->
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"
                                       placeholder="Trading Partner Name"
                                       required="1"/>
                            </h1>
                            <field name="active"
                                   widget="boolean_toggle"
                                   string="Active"/>
                        </div>

                        <!-- Identity summary (partner code + Odoo customer) -->
                        <group>
                            <group>
                                <field name="code" string="Partner code" required="1"/>
                            </group>
                            <group>
                                <field name="partner_id" string="Odoo customer"/>
                            </group>
                        </group>

                        <!-- Tabs — Connection / Parsing &amp; Matching /
                             EDI Identity / Stores (design-handoff tab spec). -->
                        <notebook>

                            <!-- ===== Connection ===== -->
                            <page string="Connection" name="connection">

                                <group>
                                    <group string="Transport">
                                        <field name="ftp_protocol"
                                               string="Transport"
                                               widget="radio"
                                               options="{'horizontal': true}"/>
                                        <field name="ftp_host" string="Host"/>
                                        <field name="ftp_port" string="Port"/>
                                    </group>
                                    <group string="Credentials">
                                        <field name="ftp_user" string="Username"/>
                                        <label for="ftp_password" string="Password"/>
                                        <div class="d-flex align-items-center">
                                            <field name="ftp_password"
                                                   password="True"
                                                   nolabel="1"
                                                   class="me-2"/>
                                            <i class="fa fa-lock text-success"
                                               title="Fernet-encrypted at rest"
                                               role="img" aria-label="Fernet-encrypted"/>
                                        </div>
                                    </group>
                                </group>

                                <div class="text-muted mb-2" style="font-size:12px">
                                    Credential fields (username, password, SFTP host key)
                                    are visible to <strong>Settings-level administrators
                                    only</strong>. Passwords are Fernet-encrypted at rest.
                                    Use <em>Test connection</em> in the header after any change.
                                </div>

                                <group>
                                    <group string="Production paths">
                                        <field name="ftp_inbox_path"
                                               string="Inbox path"
                                               placeholder="/FromEDIS"/>
                                        <field name="ftp_outbox_path"
                                               string="Outbox path"
                                               placeholder="/ToEDIS"/>
                                    </group>
                                    <group string="Test paths">
                                        <field name="ftp_test_inbox_path"
                                               string="Test inbox"
                                               placeholder="/Test/FromEDIS"/>
                                        <field name="ftp_test_outbox_path"
                                               string="Test outbox"
                                               placeholder="/Test/ToEDIS"/>
                                    </group>
                                </group>

                                <group string="SFTP host key"
                                       invisible="ftp_protocol != 'sftp'">
                                    <field name="sftp_host_key"
                                           string="Host key (base64)"
                                           nolabel="1"
                                           placeholder="AAAAB3NzaC1yc2E… (RSA server public key)"
                                           help="Pinned host key — SFTP connections to an unknown or changed key are REJECTED. Obtain with: ssh-keyscan -t rsa &lt;host&gt;. Blank rejects all SFTP connections (fail-safe)."/>
                                </group>

                                <group string="Circuit breaker">
                                    <field name="circuit_open_since"
                                           string="Tripped since"
                                           readonly="1"
                                           help="Set when repeated poll failures trip the circuit breaker; cleared automatically on the next successful poll."/>
                                </group>

                            </page>

                            <!-- ===== Parsing &amp; Matching ===== -->
                            <page string="Parsing &amp; Matching" name="parsing">

                                <group>
                                    <group string="Format &amp; parser">
                                        <field name="edi_format" string="EDI format"/>
                                        <field name="parser_class"
                                               string="Parser class"
                                               placeholder="mml_edi.parsers.briscoes_idoc.BriscoesIDOCParser"/>
                                        <field name="pricelist_id" string="Pricelist"
                                               help="EDI price comparison uses this pricelist — not the product's sale price."/>
                                <div class="alert alert-warning mb-0" role="alert" colspan="2"
                                     invisible="not pricelist_gst_warning">
                                    <field name="pricelist_gst_warning" nolabel="1" readonly="1"/>
                                </div>
                                        <field name="price_tolerance_pct"
                                               string="Price tolerance (%)"
                                               widget="percentage"
                                               help="Auto-accept orders where the EDI price is within this % of the pricelist price. 0.0 = require exact match."/>
                                    </group>
                                    <group string="Order handling">
                                        <field name="product_match_field"
                                               string="Product match"/>
                                        <field name="order_split_mode"
                                               string="Order split"/>
                                        <field name="warehouse_id"
                                               string="Fulfilment warehouse"
                                               help="Warehouse new orders for this partner are created on (overrides the EDI user default). Blank = company default."/>
                                        <field name="poll_interval_minutes"
                                               string="Poll interval (min)"
                                               help="Informational — polling runs on the global 'EDI: Poll Trading Partners' scheduled action (15 min); a per-partner interval is not yet enforced."/>
                                        <field name="client_ref_template"
                                               string="Client ref template"
                                               placeholder="{po_number}_{store_code}"/>
                                    </group>
                                </group>

                                <group string="Circuit breaker">
                                    <field name="circuit_failure_threshold"
                                           string="Failure threshold"
                                           help="Consecutive poll failures before the breaker opens and polling pauses."/>
                                    <field name="circuit_cooldown_minutes"
                                           string="Cooldown (min)"/>
                                </group>

                                <group string="Automation">
                                    <field name="auto_confirm_clean"
                                           widget="boolean_toggle"
                                           string="Auto-confirm clean orders"
                                           help="Confirm and queue ACK for orders with no blocking issues automatically. Disable for partners where human review is always required."/>
                                    <field name="alert_on_issues"
                                           widget="boolean_toggle"
                                           string="Alert on review required"
                                           help="Email EDI ops when an order is routed to manual review."/>
                                    <field name="alert_email_ids"
                                           widget="many2many_tags"
                                           string="Alert recipients"
                                           invisible="not alert_on_issues"
                                           domain="[('email', '!=', False)]"
                                           options="{'no_create_edit': True}"/>
                                </group>

                                <div class="alert alert-light text-muted mt-2" role="alert"
                                     style="font-size:11.5px">
                                    <i class="fa fa-info-circle me-1" role="img" aria-label="Info"/>
                                    Only allow-listed parser classes can be loaded. The Briscoes
                                    EDIFACT parser is intentionally de-listed until the carton→each
                                    conversion is ported — Briscoes currently sends SAP iDOC XML.
                                    Out-of-stock lines accept in full and backorder the short quantity.
                                </div>

                            </page>

                            <!-- ===== EDI Identity ===== -->
                            <page string="EDI Identity" name="edi_identity">

                                <group>
                                    <group string="Interchange sender">
                                        <field name="edi_sender_id" string="EDI sender ID"/>
                                        <field name="edi_sender_qualifier"
                                               string="Sender qualifier"/>
                                    </group>
                                    <group string="Location &amp; vendor">
                                        <field name="supplier_gln" string="Supplier GLN"/>
                                        <field name="vendor_code" string="Vendor code"/>
                                    </group>
                                </group>

                                <div class="alert alert-light text-muted mt-2" role="alert"
                                     style="font-size:11.5px">
                                    <i class="fa fa-info-circle me-1" role="img" aria-label="Info"/>
                                    Interchange identity builds the UNB envelope for EDIFACT partners
                                    (e.g. Animates via SPS Commerce). iDOC partners like Briscoes route
                                    by GLN in the iDOC header rather than a UNB envelope, so these may
                                    be left blank for them.
                                </div>

                            </page>

                            <!-- ===== Stores ===== -->
                            <page string="Stores" name="stores">

                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-muted" style="font-size:12.5px">
                                        Store map — per-store split routes each store-order to its
                                        mapped delivery contact (a child of the Odoo customer).
                                    </span>
                                    <button name="%(mml_edi.action_edi_seed_stores_wizard)d"
                                            string="Seed stores"
                                            type="action"
                                            class="btn btn-sm btn-secondary ms-auto"
                                            icon="fa-magic"
                                            invisible="order_split_mode != 'per_store'"
                                            groups="mml_edi.group_edi_manager"/>
                                </div>

                                <field name="store_partner_ids" nolabel="1" readonly="1">
                                    <list string="Store / delivery contacts" create="false" edit="false">
                                        <field name="ref" string="Store code"/>
                                        <field name="name" string="Store name"/>
                                        <field name="city" string="City"/>
                                    </list>
                                </field>

                                <div class="alert alert-warning mt-2" role="alert"
                                     style="font-size:11.5px"
                                     invisible="order_split_mode != 'per_store'">
                                    <i class="fa fa-exclamation-triangle me-1" role="img" aria-label="Warning"/>
                                    An inbound store code with no mapping raises a blocking review rather
                                    than delivering to head office.
                                </div>

                            </page>

                        </notebook>

                    </sheet>

                </form>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- WINDOW ACTION                                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="action_edi_trading_partner" model="ir.actions.act_window">
            <field name="name">Trading Partners</field>
            <field name="res_model">edi.trading.partner</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No trading partners configured
                </p>
                <p>
                    Create a trading partner profile to begin receiving EDI orders.
                    Each partner requires FTP connection details, document format,
                    and processing rules before it can be activated.
                </p>
            </field>
        </record>

    </data>
</odoo>
