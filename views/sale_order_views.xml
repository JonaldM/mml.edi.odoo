<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- INHERITED FORM VIEW — sale.order                                -->
        <!-- Injects EDI smart button into the button_box                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_sale_order_form_edi_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.edi.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Indent orders: unmissable ribbon so a forward commitment is
                     never mistaken for a stale order again. -->
                <xpath expr="//sheet" position="inside">
                    <widget name="web_ribbon" title="Indent"
                            bg_color="text-bg-info"
                            invisible="not x_is_indent"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="x_is_indent" invisible="1"/>
                    <field name="is_edi_order" invisible="1"/>
                    <field name="edi_review_id" invisible="1"/>
                    <field name="edi_trading_partner_id" invisible="1"/>
                    <button name="action_view_edi_review"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            invisible="not is_edi_order">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="edi_trading_partner_id" nolabel="1" no_open="True" readonly="1"/>
                            </span>
                            <span class="o_stat_text">EDI Review</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEARCH FILTER — indent orders                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_sale_order_search_indent" model="ir.ui.view">
            <field name="name">sale.order.search.indent</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <filter name="my_sale_orders_filter" position="after">
                    <separator/>
                    <filter name="indent_orders" string="Indent Orders"
                            domain="[('x_is_indent','=',True)]"
                            help="Forward commitments for future delivery windows"/>
                </filter>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- WINDOW ACTION — EDI Sales Orders                                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="action_edi_sale_orders" model="ir.actions.act_window">
            <field name="name">EDI Sales Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_edi_order', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No EDI sales orders yet
                </p>
                <p>
                    Sales orders created from incoming EDI purchase orders
                    will appear here.
                </p>
            </field>
        </record>

    </data>
</odoo>
