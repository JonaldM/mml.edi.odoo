<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEARCH VIEW                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_order_review_search" model="ir.ui.view">
            <field name="name">edi.order.review.search</field>
            <field name="model">edi.order.review</field>
            <field name="arch" type="xml">
                <search string="EDI Order Reviews">
                    <field name="customer_po_number" string="PO Number"/>
                    <field name="name" string="Reference"/>
                    <field name="store_code" string="Store Code"/>
                    <field name="trading_partner_id" string="Trading Partner"/>

                    <filter name="needs_review"
                            string="Needs Review"
                            domain="[('state', '=', 'pending_review')]"/>
                    <filter name="change_orders"
                            string="Change Orders"
                            domain="[('document_type', '=', 'change_order')]"/>
                    <filter name="blocking_issues"
                            string="Blocking Issues"
                            domain="[('blocking_issue_count', '&gt;', 0)]"/>
                    <filter name="auto_approved"
                            string="Auto-Approved"
                            domain="[('state', '=', 'auto_approved')]"/>
                    <filter name="today"
                            string="Today"
                            domain="[('received_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                                     ('received_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)).strftime('%Y-%m-%d %H:%M:%S'))]"/>

                    <separator/>

                    <group expand="0" string="Group By">
                        <filter name="group_by_state"
                                string="State"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_by_trading_partner"
                                string="Trading Partner"
                                context="{'group_by': 'trading_partner_id'}"/>
                        <filter name="group_by_document_type"
                                string="Document Type"
                                context="{'group_by': 'document_type'}"/>
                        <filter name="group_by_received_date"
                                string="Received Date"
                                context="{'group_by': 'received_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- KANBAN VIEW                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_order_review_kanban" model="ir.ui.view">
            <field name="name">edi.order.review.kanban</field>
            <field name="model">edi.order.review</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state"
                        quick_create="false"
                        class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="customer_po_number"/>
                    <field name="store_code"/>
                    <field name="trading_partner_id"/>
                    <field name="document_type"/>
                    <field name="state"/>
                    <field name="issue_count"/>
                    <field name="blocking_issue_count"/>
                    <field name="received_date"/>

                    <progressbar field="blocking_issue_count"
                                 colors='{"0": "success", "1": "danger"}'
                                 sum_field="blocking_issue_count"/>

                    <templates>
                        <t t-name="kanban-card">
                            <div class="oe_kanban_card oe_kanban_global_click p-2">

                                <!-- Top row: PO number + document type badge -->
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="fs-6 text-truncate me-2">
                                        <t t-esc="record.customer_po_number.value"/>
                                    </strong>
                                    <t t-if="record.document_type.raw_value === 'change_order'">
                                        <span class="badge rounded-pill text-bg-warning fw-bold ms-1">CHANGE</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge rounded-pill text-bg-primary fw-bold ms-1">NEW</span>
                                    </t>
                                </div>

                                <!-- Trading partner + store code -->
                                <div class="text-muted small mb-1">
                                    <span><t t-esc="record.trading_partner_id.value"/></span>
                                    <t t-if="record.store_code.value">
                                        <span class="ms-1 text-secondary">· <t t-esc="record.store_code.value"/></span>
                                    </t>
                                </div>

                                <!-- Issue signal -->
                                <div class="mb-2">
                                    <t t-if="record.blocking_issue_count.raw_value > 0">
                                        <span class="badge text-bg-danger">
                                            <t t-esc="record.blocking_issue_count.value"/> Blocking
                                        </span>
                                    </t>
                                    <t t-elif="record.issue_count.raw_value > 0">
                                        <span class="badge text-bg-warning">
                                            <t t-esc="record.issue_count.value"/> Issues
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge text-bg-success">Clean</span>
                                    </t>
                                </div>

                                <!-- Bottom: received date + reference -->
                                <div class="d-flex justify-content-between align-items-end">
                                    <small class="text-muted">
                                        <t t-esc="record.received_date.value"/>
                                    </small>
                                    <small class="text-muted fst-italic">
                                        <t t-esc="record.name.value"/>
                                    </small>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LIST VIEW                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_order_review_list" model="ir.ui.view">
            <field name="name">edi.order.review.list</field>
            <field name="model">edi.order.review</field>
            <field name="arch" type="xml">
                <list string="EDI Order Reviews"
                      decoration-danger="state == 'pending_review' and blocking_issue_count > 0"
                      decoration-warning="state == 'pending_review' and blocking_issue_count == 0 and issue_count > 0"
                      decoration-success="state in ('approved', 'auto_approved')"
                      decoration-muted="state == 'rejected'"
                      multi_edit="1">
                    <field name="received_date" widget="date" string="Received"/>
                    <field name="name" string="Reference"/>
                    <field name="trading_partner_id"/>
                    <field name="customer_po_number" string="PO Number"/>
                    <field name="store_code" optional="show"/>
                    <field name="document_type" widget="badge"/>
                    <field name="state" widget="badge"
                           decoration-danger="state == 'pending_review' and blocking_issue_count > 0"
                           decoration-warning="state == 'pending_review' and blocking_issue_count == 0 and issue_count > 0"
                           decoration-success="state in ('approved', 'auto_approved')"
                           decoration-muted="state == 'rejected'"/>
                    <field name="blocking_issue_count" string="Blocking" optional="show"/>
                    <field name="issue_count" string="Issues" optional="show"/>
                    <field name="sale_order_id" optional="show"/>
                    <field name="reviewed_by" optional="show"/>
                </list>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FORM VIEW                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_edi_order_review_form" model="ir.ui.view">
            <field name="name">edi.order.review.form</field>
            <field name="model">edi.order.review</field>
            <field name="arch" type="xml">
                <form string="EDI Order Review">

                    <!-- Header with state buttons and status bar -->
                    <header>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'pending_review'"
                                groups="mml_edi.group_edi_user"/>
                        <button name="action_approve_corrected"
                                string="Approve with Corrections"
                                type="object"
                                class="btn-secondary"
                                invisible="state != 'pending_review' or blocking_issue_count == 0"
                                groups="mml_edi.group_edi_user"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-danger"
                                invisible="state != 'pending_review'"
                                groups="mml_edi.group_edi_user"/>
                        <button name="action_reset_to_review"
                                string="Reset to Review"
                                type="object"
                                invisible="state == 'pending_review'"
                                groups="mml_edi.group_edi_manager"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="pending_review,approved,rejected,auto_approved"/>
                    </header>

                    <sheet>

                        <!-- Change Order Alert Banner -->
                        <div class="alert alert-warning mb-3"
                             invisible="document_type != 'change_order'"
                             role="alert">
                            <strong>CHANGE ORDER</strong> — This amends an existing PO.
                            Review the Change Summary tab before approving.
                            Approving will update the linked sales order.
                        </div>

                        <!-- Title row -->
                        <div class="oe_title">
                            <h1>
                                <field name="customer_po_number"
                                       readonly="1"
                                       string="Customer PO Number"
                                       placeholder="Customer PO Number"/>
                            </h1>
                        </div>

                        <!-- Main two-column detail section -->
                        <group>
                            <group string="Order Details">
                                <field name="trading_partner_id" readonly="1"/>
                                <field name="store_code" readonly="1"/>
                                <field name="document_type"
                                       readonly="1"
                                       widget="badge"/>
                                <field name="received_date" readonly="1"/>
                                <field name="edi_filename" readonly="1"/>
                            </group>
                            <group string="Review">
                                <field name="name"
                                       readonly="1"
                                       string="Reference"/>
                                <field name="state"
                                       readonly="1"
                                       widget="badge"/>
                                <field name="sale_order_id" readonly="1"/>
                                <field name="blocking_issue_count"
                                       readonly="1"
                                       string="Blocking Issues"/>
                                <field name="issue_count"
                                       readonly="1"
                                       string="Total Issues"/>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="reviewed_date" readonly="1"/>
                            </group>
                        </group>

                        <!-- Tabs -->
                        <notebook>

                            <!-- Issues Tab -->
                            <page string="Issues" name="issues">
                                <field name="issue_ids" nolabel="1">
                                    <list decoration-danger="severity == 'blocking'"
                                          decoration-warning="severity == 'warning'"
                                          editable="bottom">
                                        <field name="severity" widget="badge"/>
                                        <field name="issue_type" widget="badge"/>
                                        <field name="description"/>
                                        <field name="edi_price" optional="show"/>
                                        <field name="system_price" optional="show"/>
                                        <field name="price_difference_pct"
                                               optional="show"
                                               string="Diff%"/>
                                        <field name="resolution" widget="badge"/>
                                        <button name="action_accept"
                                                string="Accept"
                                                type="object"
                                                class="btn-sm btn-success"
                                                invisible="resolution != 'pending'"/>
                                        <button name="action_reject_issue"
                                                string="Reject"
                                                type="object"
                                                class="btn-sm btn-danger"
                                                invisible="resolution != 'pending'"/>
                                        <button name="action_flag_for_pricelist_update"
                                                string="Flag Pricelist"
                                                type="object"
                                                class="btn-sm btn-warning"
                                                invisible="issue_type != 'price_discrepancy' or resolution != 'pending'"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Change Summary Tab (change orders only) -->
                            <page string="Change Summary"
                                  name="change_summary"
                                  invisible="document_type != 'change_order'">
                                <group>
                                    <field name="original_review_id"
                                           readonly="1"
                                           string="Original Order Review"/>
                                </group>
                                <group>
                                    <field name="change_summary"
                                           readonly="1"
                                           widget="text"
                                           nolabel="1"
                                           no_open="True"
                                           string="Change Summary"/>
                                </group>
                                <group string="Other Change Orders on this PO"
                                       col="1">
                                    <field name="change_order_ids"
                                           nolabel="1"
                                           optional="hide">
                                        <list>
                                            <field name="name" string="Reference"/>
                                            <field name="received_date" string="Received"/>
                                            <field name="state" widget="badge"/>
                                            <field name="reviewed_by"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <!-- SO Lines Tab -->
                            <page string="Sales Order Lines" name="so_lines">
                                <field name="sale_order_line_ids"
                                       nolabel="1"
                                       readonly="1">
                                    <list>
                                        <field name="edi_line_number"
                                               optional="show"
                                               string="EDI Line #"/>
                                        <field name="product_id"/>
                                        <field name="product_uom_qty" string="Qty"/>
                                        <field name="product_uom"
                                               optional="show"
                                               string="UOM"/>
                                        <field name="edi_price"
                                               optional="show"
                                               string="EDI Price"/>
                                        <field name="price_unit"
                                               string="System Price"/>
                                        <field name="edi_price_discrepancy"
                                               optional="show"
                                               widget="boolean_toggle"/>
                                        <field name="edi_qty_shortfall"
                                               optional="show"
                                               string="Stock Shortfall"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Notes Tab -->
                            <page string="Notes" name="notes">
                                <field name="notes"
                                       widget="text"
                                       nolabel="1"
                                       placeholder="Add review notes here..."/>
                            </page>

                            <!-- Raw EDI Data Tab -->
                            <page string="Raw EDI Data" name="raw_edi">
                                <group>
                                    <field name="edi_filename" readonly="1"/>
                                </group>
                                <field name="edi_raw_data"
                                       readonly="1"
                                       widget="text"
                                       nolabel="1"
                                       style="font-family: monospace; font-size: 0.85em; white-space: pre;"/>
                            </page>

                        </notebook>
                    </sheet>

                    <!-- Chatter -->
                    <chatter/>

                </form>
            </field>
        </record>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- WINDOW ACTIONS                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- Main action: Kanban-first with default "Needs Review" filter -->
        <record id="action_edi_order_review" model="ir.actions.act_window">
            <field name="name">EDI Order Reviews</field>
            <field name="res_model">edi.order.review</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_needs_review': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No EDI orders to review
                </p>
                <p>
                    Incoming EDI purchase orders from trading partners will appear
                    here for review and approval before sales orders are confirmed.
                </p>
            </field>
        </record>

        <!-- Pending Review action: List-first, pre-filtered to pending -->
        <record id="action_edi_order_review_pending" model="ir.actions.act_window">
            <field name="name">Pending Review</field>
            <field name="res_model">edi.order.review</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('state', '=', 'pending_review')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No orders pending review
                </p>
                <p>
                    All incoming EDI orders have been processed. New orders will
                    appear here as they arrive from trading partners.
                </p>
            </field>
        </record>

    </data>
</odoo>
