<?xml version="1.0" encoding="utf-8"?>
<!-- mml_edi/views/edi_wall_mobile_actions.xml
     Client actions + menus for the EDI Wall Display (OWL tag `edi_wall`) and
     Mobile Triage (OWL tag `edi_mobile_triage`). Menus parent onto the EDI root
     defined in menuitems.xml (loaded earlier in the manifest). Kept in their own
     file so they are additive to the shell-dashboard menus. -->
<odoo>

    <!-- Wall Display — a TV-browser radiator. -->
    <record id="action_edi_wall" model="ir.actions.client">
        <field name="name">EDI Wall Display</field>
        <field name="tag">edi_wall</field>
    </record>

    <!-- Mobile Triage — the approver's pocket view. -->
    <record id="action_edi_mobile_triage" model="ir.actions.client">
        <field name="name">EDI Mobile Triage</field>
        <field name="tag">edi_mobile_triage</field>
    </record>

    <!-- Menus (parented onto menu_edi_root from menuitems.xml). -->
    <menuitem id="menu_edi_wall"
              name="Wall Display"
              parent="menu_edi_root"
              action="mml_edi.action_edi_wall"
              sequence="50"/>

    <menuitem id="menu_edi_mobile_triage"
              name="Mobile Triage"
              parent="menu_edi_root"
              action="mml_edi.action_edi_mobile_triage"
              sequence="60"/>

</odoo>
